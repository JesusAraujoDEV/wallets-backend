# PostgreSQL Database
DATABASE_URL="your_postgresql_connection_string"

# JWT
JWT_SECRET="change_this_super_secret_key"
JWT_EXPIRES_IN="7d"

# Server
PORT=4001

# Swagger / OpenAPI
# Base URL del backend que verá Swagger. No incluyas "/api" aquí; se añade automáticamente.
# Ejemplos:
# BACKEND_URL="https://api.tudominio.com"
# BACKEND_URL="http://localhost:4001"
BACKEND_URL="http://localhost:4001"

# (Opcional) Cambiar el prefijo base de las rutas de la API (por defecto "/api")
# API_BASE_PATH="/api"

# CORS - URLs del frontend permitidas (separadas por coma)
# Ejemplos:
# FRONTEND_URLS="http://localhost:8080,http://localhost:5173,https://app.tudominio.com"
FRONTEND_URLS="http://localhost:8080"

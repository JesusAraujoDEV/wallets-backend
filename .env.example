# PostgreSQL Database
DATABASE_URL="your_postgresql_connection_string"

# JWT
JWT_SECRET="change_this_super_secret_key"
JWT_EXPIRES_IN="7d"

# Server
PORT=3001

# Swagger / OpenAPI
# Base URL del backend que verá Swagger. No incluyas "/api" aquí; se añade automáticamente.
# Ejemplos:
# BACKEND_URL="https://api.tudominio.com"
# BACKEND_URL="http://localhost:3001"
BACKEND_URL="http://localhost:3001"

# (Opcional) Cambiar el prefijo base de las rutas de la API (por defecto "/api")
# API_BASE_PATH="/api"
